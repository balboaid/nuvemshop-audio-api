{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuvemshop-audio-api",
  "main": "src/index.js",
  "compatibility_date": "2025-12-21",

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "previews_db",
      "database_name": "previews-db",
      "database_id": "8698cac3-b5e9-4f96-83e2-2cd33a9952fb",
      "remote": true
    }
  ],

  "vars": {
    "PREVIEW_API_KEY": "AMG@amgJacksonRacing777"
  },

  "env": {
    "preview": {
      "vars": {
        "PREVIEW_API_KEY": "AMG@amgJacksonRacing777"
      }
    }
  }
}
